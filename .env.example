# URL base del backend REST. En desarrollo, Vite redirige /api al servidor local.
VITE_API_BASE_URL=/api

# Mientras sea "true" (valor por defecto), la app persiste en un mock en el
# navegador (localStorage) en lugar de llamar a la API. Ponlo en "false" junto
# con un VITE_API_BASE_URL real para integrar el backend.
# Ver docs/BACKEND_INTEGRATION.md.
VITE_USE_MOCK_BACKEND=true

# Herramientas exclusivas para la demostración local (selector de rol y reset).
VITE_SHOW_DEMO_TOOLS=false
